# R
.Rhistory
.RData
.Rproj.user
*.tmp
.DS_Store

# Weekly map/summary outputs are delivered by email, not committed. Keep only the
# state that must persist across runs.
#
# weather_cache.csv (the uncompressed copy) is no longer written:
# WEATHER_CACHE_KEEP_CSV is FALSE, because it was 16.4 MB against 2.1 MB for the
# gz and both were being committed every run. The negation is kept so an existing
# copy can still be staged for deletion.
blast_outputs/*
!blast_outputs/town_trends.csv
!blast_outputs/blastam_trends.csv
!blast_outputs/weather_cache.csv
!blast_outputs/weather_cache.csv.gz
!blast_outputs/fetch_failures.csv
!blast_outputs/cache_version.txt
!blast_outputs/map_stats.txt
!blast_outputs/midweek_status.txt
!blast_outputs/.gitkeep
